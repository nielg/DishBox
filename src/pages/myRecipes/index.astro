---
import type { RecipeMetaDataResponse } from "@/types/recipe";
import Button from "../../components/basic/Button.astro";
import WelcomeHeader from "../../components/basic/WelcomeHeader.astro";
import MyRecipesCard from "../../components/myRecipes/MyRecipesCard.astro";
import MyRecipesContainer from "../../components/myRecipes/MyRecipesContainer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipesService from "@/repository/recipesRepository";
import wblt from "jsonwebtoken";
import { COOKIE_NAME, COOKIE_SECRET } from "astro:env/server";
import { logoutUser } from "@/utils/auth";

let recipes: RecipeMetaDataResponse[] | null = null;

const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie) {
  const decoded = wblt.verify(cookie.value, COOKIE_SECRET) as {
    id?: number;
  } | null;

  if (!decoded) {
    return await logoutUser();
  }

  const user_id = decoded?.id;
  if (user_id) {
    recipes = await RecipesService.getRecipesMetaDataByUserId(user_id);
  }
}
---

<BaseLayout>
  {
    recipes ? (
      <div class="myRecipes-wrapper">
        <div class="header">
          <WelcomeHeader title="myRecipes" />
          <Button
            text="Add new recipe"
            link="/myRecipes/addRecipe"
            iconName="lucide:plus"
          />
        </div>
        <MyRecipesContainer>
          {recipes.map((recipe) => (
            <MyRecipesCard data={recipe} />
          ))}
        </MyRecipesContainer>
      </div>
    ) : (
      <p>login</p>
    )
  }
</BaseLayout>

<style>
  .header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
</style>
