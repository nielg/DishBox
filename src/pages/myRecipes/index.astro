---
export const prerender = false;
import type { RecipeMetaDataResponse } from "@/types/recipe";
import Button from "../../components/layout/Button.astro";
import WelcomeHeader from "../../components/layout/WelcomeHeader.astro";
import MyRecipesCard from "../../components/myRecipes/MyRecipesCard.astro";
import MyRecipesContainer from "../../components/myRecipes/MyRecipesContainer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipesService from "@/repository/recipesRepository";
import authService from "@/service/authService";

const userId = await authService.getAuthenticatedUserId(Astro.cookies);
if (!userId) return Astro.redirect("/user/login");

const recipes: RecipeMetaDataResponse[] =
  await RecipesService.getRecipesMetaDataByUserId(userId);
---

<BaseLayout>
  <div class="myRecipes-wrapper">
    <div class="header">
      <WelcomeHeader title="myRecipes" />
      <Button
        text="Add new recipe"
        link="/myRecipes/addRecipe"
        iconName="lucide:plus"
      />
    </div>
    <MyRecipesContainer>
      {recipes.map((recipe) => <MyRecipesCard data={recipe} />)}
    </MyRecipesContainer>
  </div>
</BaseLayout>

<style>
  .header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
</style>
