---
import BaseLayout from "@/components/layouts/BaseLayout.astro";
import type { RecipeResponse } from "@/types/recipe";
import RecipesService from "@/repository/recipesRepository";
import DeleteRecipeBtn from "@/components/buttons/DeleteRecipeBtn.astro";
import GoBackBtn from "@/components/buttons/GoBackBtn.astro";
import { Icon } from "astro-icon/components";

const { slug } = Astro.params;

let recipe: RecipeResponse | null = null;

if (slug) {
  const id = parseInt(slug, 10);

  if (!isNaN(id)) {
    try {
      recipe = await RecipesService.getRecipeById(id);
    } catch (error) {
      console.error(`Failed to fetch recipe with ID ${id}:`, error);
    }
  }
}

if (!recipe) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}
---

<BaseLayout
  title={recipe ? `${recipe.title} | DishBox` : "Recipe Not Found | DishBox"}
>
  {
    recipe ? (
      <div class="recipe-page">
        {/* Top navigation bar */}
        <div class="recipe-nav">
          <GoBackBtn href="/myRecipes" />
          <DeleteRecipeBtn recipeId={recipe.id} />
        </div>

        {/* Hero header */}
        <header class="recipe-hero">
          <div class="recipe-hero-badge">
            <Icon name="lucide:utensils" class="hero-badge-icon" />
            <span>Recipe</span>
          </div>
          <h1 class="recipe-title">{recipe.title}</h1>
          {recipe.description && (
            <p class="recipe-description">{recipe.description}</p>
          )}
          <div class="recipe-meta">
            <span class="meta-badge">
              <Icon name="lucide:users" class="meta-icon" />
              {recipe.portions} {recipe.portions === 1 ? "portion" : "portions"}
            </span>
            <span class="meta-badge">
              <Icon name="lucide:list" class="meta-icon" />
              {recipe.ingredients.length} ingredients
            </span>
            <span class="meta-badge">
              <Icon name="lucide:clipboard-list" class="meta-icon" />
              {recipe.instructions.length} steps
            </span>
          </div>
        </header>

        <div class="section-divider" />

        {/* Two-column content */}
        <div class="recipe-body">
          {/* Ingredients column */}
          <section class="recipe-section ingredients-section">
            <div class="section-heading">
              <div class="section-icon-wrap">
                <Icon name="lucide:shopping-basket" class="section-icon" />
              </div>
              <h2>Ingredients</h2>
            </div>
            <ul class="ingredients-list">
              {recipe.ingredients.map((item) => (
                <li class="ingredient-item">
                  <span class="ingredient-dot" />
                  {item}
                </li>
              ))}
            </ul>
          </section>

          {/* Instructions column */}
          <section class="recipe-section instructions-section">
            <div class="section-heading">
              <div class="section-icon-wrap">
                <Icon name="lucide:chef-hat" class="section-icon" />
              </div>
              <h2>Instructions</h2>
            </div>
            <ol class="instructions-list">
              {recipe.instructions.map((step, index) => (
                <li class="instruction-step">
                  <span class="step-number">{index + 1}</span>
                  <p class="step-text">{step}</p>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </div>
    ) : (
      <div class="not-found">
        <div class="not-found-icon-wrap">
          <Icon name="lucide:file-question" class="not-found-icon" />
        </div>
        <h1>Recipe Not Found</h1>
        <p>Sorry, we couldn't find the recipe you're looking for.</p>
        <GoBackBtn href="/myRecipes" />
      </div>
    )
  }
</BaseLayout>

<style>
  /* ── Page shell ─────────────────────────────────────────────── */
  .recipe-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 960px;
    margin: 0 auto;
  }

  /* ── Nav row ────────────────────────────────────────────────── */
  .recipe-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Hero header ────────────────────────────────────────────── */
  .recipe-hero {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .recipe-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--primary-50);
    color: var(--primary-700);
    border: 1px solid var(--primary-200);
    padding: 0.3rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    width: fit-content;
  }

  .hero-badge-icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  .recipe-title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .recipe-description {
    margin: 0;
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 680px;
  }

  .recipe-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--primary-700);
    background-color: var(--primary-50);
    border: 1px solid var(--primary-200);
    border-radius: 2rem;
  }

  .meta-icon {
    width: 0.85rem;
    height: 0.85rem;
  }

  /* ── Divider ────────────────────────────────────────────────── */
  .section-divider {
    width: 100%;
    height: 1px;
    background: var(--border-subtle);
  }

  /* ── Two-column body ────────────────────────────────────────── */
  .recipe-body {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 680px) {
    .recipe-body {
      grid-template-columns: 1fr;
    }
  }

  /* ── Shared section styles ──────────────────────────────────── */
  .recipe-section {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .section-icon-wrap {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    background: var(--gradient-seafoam);
    border: 1px solid var(--primary-200);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .section-icon {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--primary-700);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* ── Ingredients list ───────────────────────────────────────── */
  .ingredients-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ingredient-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
    transition: background-color 0.15s ease;
  }

  .ingredient-item:hover {
    background-color: var(--bg-surface-subtle);
  }

  .ingredient-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: var(--primary-400);
    flex-shrink: 0;
    margin-top: 0.45rem;
  }

  /* ── Instructions list ──────────────────────────────────────── */
  .instructions-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .instruction-step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .step-number {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gradient-ocean);
    color: var(--text-inverse);
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-ocean);
  }

  .step-text {
    margin: 0;
    padding-top: 0.35rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* ── 404 state ──────────────────────────────────────────────── */
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 5rem 2rem;
    text-align: center;
  }

  .not-found-icon-wrap {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--gradient-seafoam);
    border: 1px solid var(--primary-200);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-icon {
    width: 2.2rem;
    height: 2.2rem;
    color: var(--primary-600);
  }

  .not-found h1 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .not-found p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
