---
import BaseLayout from "@/components/layouts/BaseLayout.astro";
import EditRecipeForm from "@/components/myRecipes/edit/EditRecipeForm";
import WelcomeHeader from "@/components/layout/WelcomeHeader.astro";
import GoBackBtn from "@/components/buttons/GoBackBtn.astro";
import RecipesService from "@/repository/dishBox/recipesRepositorypository";
import TagRepository from "@/repository/dishBox/recipes/tagRepositoryes/tagRepository";
import type { RecipeResponse } from "@/types/recipe/recipe.schemas";
import DeleteRecipeBtn from "@/components/buttons/DeleteRecipeBtn.astro";

const tags = await TagRepository.getAllTags();
const { slug } = Astro.params;
const { user_id } = Astro.locals;
let recipe: RecipeResponse | undefined;

if (slug) {
  const id = parseInt(slug, 10);

  if (!isNaN(id)) {
    try {
      recipe = await RecipesService.getRecipeById(id);
    } catch (error) {
      console.error(`Failed to fetch recipe with ID ${id}:`, error);
    }
  }
}

const isForbidden = recipe?.user_id !== user_id;

if (!recipe || isForbidden) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}
---

<BaseLayout title="Edit Recipe | DishBox">
  <div class="page-wrapper">
    <div class="page-nav">
      <GoBackBtn href="/myRecipes" />
      <DeleteRecipeBtn recipeId={recipe.id} />
    </div>
    <WelcomeHeader
      title="Edit Recipe"
      subtitle="Update the details below to modify your recipe"
    />
    <EditRecipeForm inputRecipe={recipe} tags={tags} client:load />
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
</style>
