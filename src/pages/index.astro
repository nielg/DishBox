---
import BaseLayout from "../components/layouts/BaseLayout.astro";
import RecipeService from "@/service/recipeService";
import RecipesCarrousel from "@/components/recipes/RecipesCarrousel.astro";
import type { RecipeMetaDataResponse } from "@/types/recipe/recipe.schemas";
import SearchRecipe from "@/components/recipes/SearchRecipe";
import TagRepository from "@/repository/tagRepository";

const { user_id } = Astro.locals;

const recipes: RecipeMetaDataResponse[] =
  await RecipeService.getPublickRecipesMetaData(user_id);

const tags: string[] = await TagRepository.getAllTags();

let favoriteRecipes: RecipeMetaDataResponse[] = [];
console.log(user_id);
if (user_id) {
  favoriteRecipes = await RecipeService.getUserFavoriteRecipesMetaData(user_id);
}
---

<BaseLayout>
  <h1>Recipes</h1>
  <SearchRecipe
    client:load
    initialRecipes={recipes}
    tags={tags}
    userId={user_id}
  />
  {
    favoriteRecipes.length > 0 && (
      <RecipesCarrousel title="Favorite Recipes" recipes={favoriteRecipes} />
    )
  }
</BaseLayout>
