---
import MyRecipesCard from "@/components/myRecipes/MyRecipesCard.astro";
import type { RecipeMetaDataResponse } from "@/types/recipe/recipe/recipe";

type Props = {
  title: string;
  recipes: RecipeMetaDataResponse[];
};

const { title, recipes } = Astro.props as Props;
---

<section class="recipes-carrousel">
  <h2>{title}</h2>
  <div class="recipes-carrousel__container">
    {recipes.map((recipe) => <MyRecipesCard data={recipe} />)}
  </div>
</section>
