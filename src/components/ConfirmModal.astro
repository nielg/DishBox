---
interface Props {
  modalId: string;
  title?: string;
  message: string;
  actionUrl: string;
  method?: "POST" | "DELETE";
}

const {
  modalId,
  title = "Are you sure?",
  message,
  actionUrl,
  method = "POST",
} = Astro.props;
---

<dialog id={modalId} class="confirm-modal">
  <div class="modal-content">
    <h3>{title}</h3>
    <p>{message}</p>

    <div class="btn-container">
      <button type="button" class="cancel-btn btn">Cancel</button>
      <button
        type="button"
        class="confirm-btn btn"
        data-url={actionUrl}
        data-method={method}
      >
        Confirm
      </button>
    </div>
  </div>
</dialog>

<script>
  const modals = document.querySelectorAll<HTMLDialogElement>(".confirm-modal");

  modals.forEach((modal) => {
    const cancelBtn = modal.querySelector(".cancel-btn");
    const confirmBtn = modal.querySelector<HTMLButtonElement>(".confirm-btn");

    // Close modal on cancel
    cancelBtn?.addEventListener("click", () => modal.close());

    // Handle fetch on confirm
    confirmBtn?.addEventListener("click", async () => {
      const url = confirmBtn.dataset.url;
      const method = confirmBtn.dataset.method;

      if (!url) return;

      try {
        const response = await fetch(url, {
          method: method || "POST",
          headers: {
            "Content-Type": "application/json",
          },
        });

        if (response.ok) {
          modal.close();
          // Reload or redirect to reflect changes
          window.location.reload();
        } else {
          console.error("Failed request with status:", response.status);
        }
      } catch (error) {
        console.error("Fetch error:", error);
      }
    });
  });
</script>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }
  dialog {
    border: none;
    border-radius: 8px;
    padding: 1.5rem;
  }

  .btn-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    margin-top: 2rem;
  }
</style>
