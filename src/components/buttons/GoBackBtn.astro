---
import { Icon } from "astro-icon/components";
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a href={href} class="btn">
  <Icon name="lucide:arrow-left" class="btnIcon" />
  <span>Back to recipes</span>
</a>

<style>
  .btn:hover .btnIcon {
    transform: translateX(-2px);
  }
</style>
