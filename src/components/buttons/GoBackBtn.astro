---
import { Icon } from "astro-icon/components";
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a href={href} class="btn">
  <Icon name="lucide:arrow-left" class="icon-class" />
  <span>Go Back</span>
</a>

<style>
  .btn {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    column-gap: 1rem;
  }
</style>
