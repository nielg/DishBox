---
import { Icon } from "astro-icon/components";
---

<div class="login-card">
  <div class="login-header">
    <div class="brand-badge">
      <Icon name="lucide:utensils" class="brand-icon" />
      <span>DishBox</span>
    </div>
    <h1>Welcome Back</h1>
    <p class="subtitle">Sign in to manage and explore your recipes</p>
  </div>

  <form id="login-form" novalidate>
    <div id="login-error-container" class="error-banner hidden">
      <Icon name="lucide:alert-circle" class="error-icon" />
      <span id="login-error-message"></span>
    </div>

    <div class="input-group">
      <label for="usernameInput">Username</label>
      <div class="input-wrapper">
        <Icon name="lucide:user" class="input-icon" />
        <input
          type="text"
          name="username"
          id="usernameInput"
          placeholder="Enter your username"
          required
          autocomplete="username"
        />
      </div>
      <p id="username-required" class="field-error">Please enter a username.</p>
    </div>

    <div class="input-group">
      <label for="passwordInput">Password</label>
      <div class="input-wrapper">
        <Icon name="lucide:lock" class="input-icon" />
        <input
          type="password"
          name="password"
          id="passwordInput"
          placeholder="••••••••"
          minlength="8"
          required
          autocomplete="current-password"
        />
      </div>
      <p id="password-required" class="field-error">
        Password is required and needs to be at lead 8 characters long.
      </p>
    </div>

    <button type="submit" id="submit-btn" class="submit-btn">
      <span id="submit-text">Sign In</span>
      <Icon name="lucide:arrow-right" class="btn-icon" />
    </button>
  </form>

  <div class="login-footer">
    <p>
      Don't have an account yet?{" "}
      <a href="/user/register" class="register-link">Register here</a>
    </p>
  </div>
</div>

<style>
  .login-card {
    width: 100%;
    max-width: 440px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1.5rem;
    padding: 2.75rem 2.25rem;
    box-shadow: var(--shadow-lg), var(--shadow-ocean);
    box-sizing: border-box;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .login-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--primary-50);
    color: var(--primary-700);
    border: 1px solid var(--primary-200);
    padding: 0.35rem 0.85rem;
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .brand-icon {
    width: 1rem;
    height: 1rem;
    color: var(--primary-600);
  }

  h1 {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.025em;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  #login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }

  label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 1rem;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--text-muted);
    pointer-events: none;
    transition: color 0.2s ease;
  }

  input {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.75rem;
    font-size: 0.95rem;
    color: var(--text-primary);
    background-color: var(--bg-surface-subtle);
    border: 1.5px solid var(--border-default);
    border-radius: 0.75rem;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
    font-family: inherit;
  }

  input:hover {
    border-color: var(--primary-400);
  }

  input:focus {
    background-color: var(--bg-surface);
    border-color: var(--primary-600);
    box-shadow: 0 0 0 3.5px rgba(13, 148, 136, 0.15);
  }

  .input-wrapper:focus-within .input-icon {
    color: var(--primary-600);
  }

  /* Added styles for inline validation messages */
  .field-error {
    display: none;
    font-size: 0.8rem;
    color: var(--error, #e11d48);
    margin: 0.15rem 0 0 0;
  }

  .field-error.shown {
    display: block;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.875rem 1.5rem;
    margin-top: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-inverse);
    background: var(--gradient-ocean);
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    box-shadow: var(--shadow-ocean);
    transition:
      transform 0.15s ease,
      box-shadow 0.2s ease,
      filter 0.2s ease;
    font-family: inherit;
  }

  .submit-btn:hover {
    transform: translateY(-1.5px);
    filter: brightness(1.05);
    box-shadow: 0 12px 25px -4px rgba(13, 148, 136, 0.35);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .btn-icon {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.2s ease;
  }

  .submit-btn:hover .btn-icon {
    transform: translateX(3px);
  }

  .error-banner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background-color: var(--error-bg);
    border: 1px solid rgba(225, 29, 72, 0.25);
    border-radius: 0.65rem;
    color: var(--error);
    font-size: 0.875rem;
    font-weight: 500;
    text-align: left;
  }

  .error-banner.hidden {
    display: none;
  }

  .error-icon {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }

  .login-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .login-footer p {
    margin: 0;
  }

  .register-link {
    color: var(--primary-600);
    font-weight: 600;
    text-decoration: none;
    transition:
      color 0.15s ease,
      text-decoration 0.15s ease;
  }

  .register-link:hover {
    color: var(--primary-800);
    text-decoration: underline;
  }
</style>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorContainer = document.getElementById(
    "login-error-container",
  ) as HTMLDivElement;
  const errorMsg = document.getElementById(
    "login-error-message",
  ) as HTMLSpanElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const submitText = document.getElementById("submit-text") as HTMLSpanElement;

  const passwordInput = document.getElementById(
    "passwordInput",
  ) as HTMLInputElement;
  const usernameInput = document.getElementById(
    "usernameInput",
  ) as HTMLInputElement;
  const passwordRequired = document.getElementById(
    "password-required",
  ) as HTMLParagraphElement;
  const usernameRequired = document.getElementById(
    "username-required",
  ) as HTMLParagraphElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Clear global error state
    if (errorContainer) errorContainer.classList.add("hidden");
    if (errorMsg) errorMsg.textContent = "";

    // Perform client validation check
    let valid = true;

    if (!usernameInput.checkValidity()) {
      usernameRequired?.classList.add("shown");
      valid = false;
    } else {
      usernameRequired?.classList.remove("shown");
    }

    if (!passwordInput.checkValidity()) {
      passwordRequired?.classList.add("shown");
      valid = false;
    } else {
      passwordRequired?.classList.remove("shown");
    }

    if (!valid) return;

    // Set UI loading state
    if (submitBtn && submitText) {
      submitBtn.disabled = true;
      submitText.textContent = "Signing in...";
    }

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    try {
      const response = await fetch("/api/user/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const data = await response.json();

      if (!response.ok) {
        if (errorContainer && errorMsg) {
          errorMsg.textContent =
            data.error ||
            data.message ||
            "Login failed. Please check your credentials.";
          errorContainer.classList.remove("hidden");
        }
        console.error("Login failed", data);
        return;
      }

      window.location.href = data.redirectUrl || "/";
    } catch (error) {
      if (errorContainer && errorMsg) {
        errorMsg.textContent =
          "An unexpected network error occurred. Please try again.";
        errorContainer.classList.remove("hidden");
      }
      console.error("An unexpected network error occurred.", error);
    } finally {
      if (submitBtn && submitText) {
        submitBtn.disabled = false;
        submitText.textContent = "Sign In";
      }
    }
  });
</script>
