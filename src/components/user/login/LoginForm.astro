<form id="login-form">
  <div>
    <label for="username">username:</label>
    <br />
    <input type="text" name="username" id="username" required />
  </div>
  <div>
    <label for="password">Password:</label>
    <br />
    <input type="password" name="password" id="password" required />
  </div>
  <p>Don't have a account yet? <a href="/user/register">register here</a></p>
  <button type="submit">Submit</button>
  <p id="login-error-message" style="color: red;"></p>
</form>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorMsg = document.getElementById(
    "login-error-message",
  ) as HTMLParagraphElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorMsg) errorMsg.textContent = "";

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    try {
      const response = await fetch("/api/user/login", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      });

      const data = await response.json();

      if (!response.ok) {
        if (errorMsg) {
          errorMsg.textContent = data.error || data.message || "Login failed";
        }
        console.error("Login failed", data);
        return;
      }

      window.location.href = data.redirectUrl || "/";
    } catch (error) {
      if (errorMsg) {
        errorMsg.textContent = "An unexpected network error occurred.";
      }
      console.error("An unexpected network error occurred.");
    }
  });
</script>
