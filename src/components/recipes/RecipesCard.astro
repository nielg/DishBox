---
import { Image } from "astro:assets";
import defaultImg from "@/assets/recipes-img/default-img.png";
import { Icon } from "astro-icon/components";
import type { RecipeMetaDataResponse } from "@/types/recipe/recipe.types";

type Props = {
  data: RecipeMetaDataResponse;
};

const { data }: Props = Astro.props;
console.log("RecipeCard data:", data);
---

<a href={`/myRecipes/${data.id}`} class="card-link">
  <article class="card">
    <div class="card-thumbnail">
      <Image
        class="card-img"
        src={defaultImg}
        width={280}
        height={160}
        alt={`${data.title} thumbnail`}
      />
      {
        data.vegan && (
          <span class="badge vegan-badge">
            <Icon name="lucide:leaf" class="badge-icon" />
            Vegan
          </span>
        )
      }
      <div class="card-img-overlay"></div>
    </div>
    <div class="card-body">
      <h3 class="card-title">{data.title}</h3>
      {data.description && <p class="card-desc">{data.description}</p>}
      <div class="card-footer">
        <span class="view-link">
          View recipe
          <Icon name="lucide:arrow-right" class="arrow-icon" />
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    box-shadow: var(--shadow-md);
    transition:
      transform 0.2s ease,
      box-shadow 0.25s ease,
      border-color 0.2s ease;
    height: 100%;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), var(--shadow-ocean);
    border-color: var(--primary-300);
  }

  .card-thumbnail {
    position: relative;
    width: 100%;
    height: 10rem;
    overflow: hidden;
    background-color: var(--bg-surface-subtle);
  }

  .vegan-badge {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--primary-700);
    background-color: var(--primary-100);
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    width: 3rem;
    height: 1.5rem;
    z-index: 1000;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .card:hover .card-img {
    transform: scale(1.04);
  }

  .card-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(13, 148, 136, 0.12) 100%
    );
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.1rem;
    flex: 1;
  }

  .card-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-desc {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.65rem;
    border-top: 1px solid var(--border-subtle);
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary-600);
    transition:
      gap 0.2s ease,
      color 0.15s ease;
  }

  .card:hover .view-link {
    gap: 0.5rem;
    color: var(--primary-800);
  }

  .arrow-icon {
    width: 0.85rem;
    height: 0.85rem;
  }
</style>
